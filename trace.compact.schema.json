{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cpp-visualizer.example/trace-compact-1.0.schema.json",
  "title": "StackBloom compact trace 1.0",
  "description": "Checkpoints plus bounded deltas. Expanding it yields a trace valid against trace.schema.json.",
  "type": "object", "additionalProperties": false,
  "required": ["format", "checkpoint_interval", "schema_version", "source", "limits", "entries"],
  "properties": {
    "format": {"const": "cppv-compact-1.0"},
    "checkpoint_interval": {"type": "integer", "minimum": 1, "maximum": 5000},
    "schema_version": {"const": "1.0"},
    "source": {
      "type": "object", "additionalProperties": false, "required": ["path", "text"],
      "properties": {"path": {"type": "string"}, "text": {"type": "string"}}
    },
    "limits": {
      "type": "object", "additionalProperties": false,
      "required": ["max_steps", "timeout_seconds", "max_output_bytes"],
      "properties": {
        "max_steps": {"type": "integer", "minimum": 1, "maximum": 5000},
        "timeout_seconds": {"type": "number", "exclusiveMinimum": 0, "maximum": 120},
        "max_output_bytes": {"type": "integer", "minimum": 1}
      }
    },
    "entries": {
      "type": "array", "minItems": 1, "maxItems": 5002,
      "items": {"anyOf": [{"$ref": "#/$defs/checkpoint"}, {"$ref": "#/$defs/delta"}]}
    }
  },
  "$defs": {
    "checkpoint": {
      "type": "object", "additionalProperties": false, "required": ["kind", "snapshot"],
      "properties": {"kind": {"const": "full"}, "snapshot": {"type": "object"}}
    },
    "delta": {
      "type": "object", "additionalProperties": false, "required": ["kind", "id", "changes"],
      "properties": {
        "kind": {"const": "delta"},
        "id": {"type": "integer", "minimum": 0},
        "changes": {
          "type": "object", "additionalProperties": false,
          "properties": {
            "event": {"type": "string"},
            "location": {"type": ["object", "null"]},
            "thread_id": {"type": ["integer", "null"]},
            "diagnostic": {"type": ["object", "null"]},
            "output_truncated": {"type": "boolean"},
            "heap_truncated": {"type": "boolean"},
            "returns": {"type": "array"},
            "frames": {"type": "array", "items": {"type": ["object", "null"]}},
            "heap_upsert": {"type": "object"},
            "heap_remove": {"type": "array", "items": {"type": "string"}},
            "stdout": {"type": "string"}, "stderr": {"type": "string"},
            "stdout_append": {"type": "string"}, "stderr_append": {"type": "string"},
            "drop": {"type": "array", "items": {"type": "string"}}
          }
        }
      }
    }
  }
}
